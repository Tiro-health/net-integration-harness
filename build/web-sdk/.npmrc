# Scope mapping only — deliberately NO _authToken here. Dependabot reads this
# file (this directory is in .github/dependabot.yml) and a literal
# ${NODE_AUTH_TOKEN} it cannot resolve overrides its injected credentials,
# failing the update with private_source_authentication_failure. CI gets auth
# from actions/setup-node; local dev from ~/.npmrc (see README.md).
@tiro-health:registry=https://npm.pkg.github.com
