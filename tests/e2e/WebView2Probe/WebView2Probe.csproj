<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Exe, not WinExe: a WinExe detaches from the console, so the runner loses both the
         probe's report and its exit code (observed as an empty $LASTEXITCODE). A console
         app can still create windows and run a WinForms message pump. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifiers>win</RuntimeIdentifiers>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>Tiro.Health.FormFiller.WebView2.E2E</RootNamespace>
    <AssemblyName>WebView2Probe</AssemblyName>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Tiro.Health.FormFiller.WebView2.Fhir.R5\Tiro.Health.FormFiller.WebView2.Fhir.R5.csproj" />
    <!-- Stage B3 runs $extract over the QR the element produced, like the ExtractSample. -->
    <ProjectReference Include="..\..\..\src\Tiro.Health.FormSdk.Client.Fhir.R5\Tiro.Health.FormSdk.Client.Fhir.R5.csproj" />
  </ItemGroup>

</Project>
