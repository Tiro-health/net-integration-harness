<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Tiro.Health.FormFiller.WebView2.Sdc.Fhir.R5</RootNamespace>
    <AssemblyName>Tiro.Health.FormFiller.WebView2.Sdc.Fhir.R5</AssemblyName>
    <RuntimeIdentifiers>win</RuntimeIdentifiers>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <Authors>Thibault Mahieu</Authors>
    <Company>Tiro.health</Company>
    <Description>Opt-in SDC convenience bridging the R5 form viewer and the SDC client: TiroFormViewerR5.ExtractAsync without configuring an SdcClient.</Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\packages</PackageOutputPath>
  </PropertyGroup>

  <!-- The only place the form-filler and the SDC client meet. Neither core gains a dependency on
       the other; consumers opt in by referencing this package. -->
  <ItemGroup>
    <ProjectReference Include="..\Tiro.Health.FormFiller.WebView2.Fhir.R5\Tiro.Health.FormFiller.WebView2.Fhir.R5.csproj" />
    <ProjectReference Include="..\Tiro.Health.FormSdk.Client.Fhir.R5\Tiro.Health.FormSdk.Client.Fhir.R5.csproj" />
  </ItemGroup>

  <!-- SdcConnection's ctor signature mentions HttpClient; net48 needs the framework assembly even
       though this package's own API never takes one. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
