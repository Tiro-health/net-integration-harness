<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net48</TargetFrameworks>
    <AssemblyName>Tiro.Health.Telemetry.Abstractions</AssemblyName>
    <RootNamespace>Tiro.Health.Telemetry</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
    <Version>1.0.0</Version>
    <Authors>Thibault Mahieu</Authors>
    <Company>Tiro.health</Company>
    <Description>Backend-agnostic telemetry abstraction (sessions, spans, sinks) shared by the Tiro.Health form-filler and SDC client packages. The Sentry-backed adapter ships in Tiro.Health.FormFiller.WebView2.Sentry.</Description>
    <AutoGenerateBindingRedirects>True</AutoGenerateBindingRedirects>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\packages</PackageOutputPath>
  </PropertyGroup>

</Project>
