<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>Tiro.Health.FormFiller.WebView2</RootNamespace>
    <AssemblyName>Tiro.Health.FormFiller.WebView2</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifiers>win</RuntimeIdentifiers>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <Authors>Thibault Mahieu</Authors>
    <Company>Tiro.health</Company>
    <Description>SMART Web Messaging — WinForms WebView2 form filler control.</Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\packages</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hl7.Fhir.Base" Version="5.13.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3650.58" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tiro.Health.SmartWebMessaging\Tiro.Health.SmartWebMessaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tiro.Health.FormFiller.WebView2.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="WebAssets\index.html">
      <LogicalName>$(RootNamespace).WebAssets.index.html</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="WebAssets\tiro-swm-bridge.js">
      <LogicalName>$(RootNamespace).WebAssets.tiro-swm-bridge.js</LogicalName>
    </EmbeddedResource>
    <!-- Staged by `cd build/web-sdk && npm ci && node copy-bundle.mjs` (GH-59/GH-60);
         gitignored. The harness embeds the exact web-sdk it was validated against and
         serves it to the page itself — the page carries no SDK script tag. -->
    <EmbeddedResource Include="WebAssets\tiro-web-sdk.iife.js">
      <LogicalName>$(RootNamespace).WebAssets.tiro-web-sdk.iife.js</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="WebAssets\web-sdk.version.json">
      <LogicalName>$(RootNamespace).WebAssets.web-sdk.version.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- A package without the pinned bundle is a broken control (no-opt-out embedding,
       GH-60), so a build without it must fail loudly rather than skip silently. -->
  <Target Name="EnsureWebSdkBundleStaged" BeforeTargets="BeforeBuild;GenerateNuspec">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\WebAssets\tiro-web-sdk.iife.js') Or !Exists('$(MSBuildProjectDirectory)\WebAssets\web-sdk.version.json')"
           Text="The pinned tiro-web-sdk bundle is not staged. Run: cd build/web-sdk &amp;&amp; npm ci &amp;&amp; node copy-bundle.mjs (needs GitHub Packages read auth — see build/web-sdk/README.md). GH-59/GH-60." />
  </Target>

</Project>
