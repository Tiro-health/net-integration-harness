<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>Tiro.Health.FormFiller.WebView2</RootNamespace>
    <AssemblyName>Tiro.Health.FormFiller.WebView2</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifiers>win</RuntimeIdentifiers>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <Authors>Thibault Mahieu</Authors>
    <Company>Tiro.health</Company>
    <Description>SMART Web Messaging — WinForms WebView2 form filler control.</Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\packages</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hl7.Fhir.Base" Version="5.13.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3650.58" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.7" />
  </ItemGroup>

  <!-- HttpClient appears in the SDC version-probe signature the viewer calls; on .NET
       Framework it lives in the framework System.Net.Http assembly, which SDK-style net48
       projects don't reference by default. -->
  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tiro.Health.SmartWebMessaging\Tiro.Health.SmartWebMessaging.csproj" />
    <!-- The shared SDC-server contract (MinimumSdcVersion + the version probe), also
         referenced by Tiro.Health.FormSdk.Client. The two surfaces that talk to the same
         SDC server share one floor rather than each carrying a copy that can drift. This is
         the "deliberate shared config type" exception to keeping the client and the viewer
         independent (GH-37 Decision 1); it is UI-free, FHIR-model-free, and pulls in no
         package the viewer's closure didn't already have. -->
    <ProjectReference Include="..\Tiro.Health.FormSdk.Abstractions\Tiro.Health.FormSdk.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tiro.Health.FormFiller.WebView2.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="WebAssets\index.html">
      <LogicalName>$(RootNamespace).WebAssets.index.html</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="WebAssets\tiro-swm-bridge.js">
      <LogicalName>$(RootNamespace).WebAssets.tiro-swm-bridge.js</LogicalName>
    </EmbeddedResource>
    <!-- Committed to this repo (GH-59/GH-60); copy-bundle.mjs regenerates it only when the pin
         moves. The harness embeds the exact web-sdk it was validated against and serves it to
         the page itself — the page carries no SDK script tag. -->
    <EmbeddedResource Include="WebAssets\tiro-web-sdk.iife.js">
      <LogicalName>$(RootNamespace).WebAssets.tiro-web-sdk.iife.js</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="WebAssets\web-sdk.version.json">
      <LogicalName>$(RootNamespace).WebAssets.web-sdk.version.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- A package without the pinned bundle is a broken control (no-opt-out embedding,
       GH-60), so a build with a missing OR mismatched bundle must fail loudly.

       The bundle is committed (GH-59/GH-60): it is public — the same bytes are served from
       cdn.tiro.health and ship inside the NuGet package on nuget.org — so requiring a private
       registry token to obtain it protected nothing and made `git clone && build` fail for
       everyone who had not set one up. Committing it removes the token, the npm install and
       the staging step from every build, including CI. -->
  <Target Name="EnsureWebSdkBundleStaged" BeforeTargets="BeforeBuild;GenerateNuspec">
    <PropertyGroup>
      <_WebSdkManifest>$(MSBuildProjectDirectory)\WebAssets\web-sdk.version.json</_WebSdkManifest>
      <_WebSdkPinFile>$(MSBuildProjectDirectory)\..\..\build\web-sdk\package.json</_WebSdkPinFile>
    </PropertyGroup>
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\WebAssets\tiro-web-sdk.iife.js') Or !Exists('$(_WebSdkManifest)')"
           Text="WebAssets/tiro-web-sdk.iife.js or web-sdk.version.json is missing. Both are committed to this repo, so something deleted them — `git checkout -- src/Tiro.Health.FormFiller.WebView2/WebAssets/` restores them. (A `git clean -xdf` will not: they are tracked, not generated.) GH-59/GH-60." />
    <PropertyGroup Condition="Exists('$(_WebSdkManifest)') And Exists('$(_WebSdkPinFile)')">
      <_WebSdkPinned>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(_WebSdkPinFile)')), '&quot;@tiro-health/web-sdk&quot;\s*:\s*&quot;([^&quot;]+)&quot;').Result('$1'))</_WebSdkPinned>
      <_WebSdkStaged>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(_WebSdkManifest)')), '&quot;version&quot;\s*:\s*&quot;([^&quot;]+)&quot;').Result('$1'))</_WebSdkStaged>
      <_WebSdkExpectedHash>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(_WebSdkManifest)')), '&quot;sha256&quot;\s*:\s*&quot;([^&quot;]+)&quot;').Result('$1'))</_WebSdkExpectedHash>
    </PropertyGroup>
    <!-- Stale staging is self-consistent (bundle + manifest agree with each other), so
         nothing downstream can catch it: the served URL would carry the stale manifest's
         version and resolve to the stale bytes. This gate is the only check. -->
    <Error Condition="Exists('$(_WebSdkManifest)') And Exists('$(_WebSdkPinFile)') And '$(_WebSdkPinned)' != '$(_WebSdkStaged)'"
           Text="The committed web-sdk bundle is v$(_WebSdkStaged) but build/web-sdk pins v$(_WebSdkPinned). Bumping the pin does not update the bundle: run `cd build/web-sdk &amp;&amp; npm ci &amp;&amp; node copy-bundle.mjs` and COMMIT the result. GH-59." />

    <!-- The pin/manifest check above compares two small TEXT files and cannot see the 6 MB
         bundle at all. That was safe while copy-bundle.mjs wrote both in one run from one
         verified tarball; now they are two independently committed files, and a commit can
         separate them — `git add -p`, a partial cherry-pick, a conflict resolution taking the
         manifest from one side and the bundle from the other. The result is a self-consistent
         lie: pin and manifest agree, so nothing above fires, and the harness serves stale bytes
         from a URL naming the new version. This is what npm's package-lock integrity used to
         provide for free. -->
    <GetFileHash Condition="Exists('$(MSBuildProjectDirectory)\WebAssets\tiro-web-sdk.iife.js') And '$(_WebSdkExpectedHash)' != ''"
                 Files="$(MSBuildProjectDirectory)\WebAssets\tiro-web-sdk.iife.js"
                 Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Hash" PropertyName="_WebSdkActualHash" />
    </GetFileHash>
    <Error Condition="'$(_WebSdkExpectedHash)' != '' And '$(_WebSdkActualHash)' != '' And '$(_WebSdkExpectedHash)' != '$(_WebSdkActualHash)'"
           Text="WebAssets/tiro-web-sdk.iife.js does not match the sha256 in web-sdk.version.json (expected $(_WebSdkExpectedHash), got $(_WebSdkActualHash)). The bundle and its manifest were committed out of step, or the file was altered in transit — a Windows checkout will corrupt it unless .gitattributes marks it binary. Re-run `cd build/web-sdk &amp;&amp; npm ci --ignore-scripts &amp;&amp; node copy-bundle.mjs` and commit BOTH files. GH-59." />
  </Target>

</Project>
