<Project>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- Building a net48 target off Windows needs the .NET Framework reference assemblies
         as a package, and the SDK adds this reference implicitly — but only there. It then
         lands in packages.lock.json, and CI restores in locked mode on Windows, where the
         implicit reference does not exist: NU1004, naming a package nobody wrote down, on a
         machine that never ran the build that changed the file (GH-73).

         Declaring it makes both platforms resolve the same graph. PrivateAssets="all" keeps
         it out of the published packages' dependencies, since it is purely a build-time
         concern for the compiler's reference assemblies.

         In .targets rather than .props because $(TargetFramework) is not yet set when
         Directory.Build.props is evaluated for a single-target project. The condition is
         per-TargetFramework, so it also applies to the net48 half of the multi-targeted
         projects and not to their netstandard2.0 or net8.0 halves. The old-style VB samples
         use TargetFrameworkVersion and the installed targeting pack, so they neither match
         this nor need it. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Pin every ProjectReference-derived package dependency to an EXACT version.

       Pack turns a ProjectReference into a ">= $(Version)" dependency, and NuGet resolves a
       shared transitive to the highest version anything in the graph asks for. Since the
       README has integrators reference two top-level packages independently, the mixed graph
       is the documented usage: viewer 1.3.0 plus client 1.2.0 resolves the shared
       Tiro.Health.FormSdk.Abstractions to 1.3.0, and the older client binary then enforces
       whatever MinimumSdcVersion that newer package carries — a floor it was never validated
       against, producing a refusal nobody chose. The package exists specifically to stop a
       version number drifting between assemblies; a ">=" dependency hands that decision back
       to the resolver.

       Exact ranges make GH-64's "integrators pick one version" a restore-time invariant: a
       mixed graph fails restore with NU1107 instead of silently resolving. All src projects
       are packed from one tag with one -p:Version (see .github/workflows/nuget-publish.yml),
       so a consistent set always exists. This also closes the same pre-existing hole on
       Tiro.Health.SmartWebMessaging and the FormFiller core. -->
  <Target Name="PinProjectReferenceRangesToExactVersions" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions ProjectVersion="[%(ProjectVersion)]"
                                      Condition="'%(ProjectVersion)' != '' and !$([System.String]::Copy('%(ProjectVersion)').StartsWith('['))" />
    </ItemGroup>
  </Target>

</Project>
